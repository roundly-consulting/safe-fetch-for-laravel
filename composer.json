{
    "name": "roundly-consulting/safe-fetch-for-laravel",
    "description": "SSRF protection for Laravel's HTTP client: strict URL canonicalising, private and cloud-metadata address blocking, DNS pinning, re-vetted redirects and a validation rule.",
    "keywords": [
        "ssrf",
        "security",
        "url-validation",
        "dns-pinning",
        "http-client",
        "private-network",
        "outbound-requests"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/safe-fetch-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/safe-fetch-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/translation": "^13.0",
        "illuminate/validation": "^13.0",
        "roundly-consulting/enums-for-laravel": "^2.0",
        "roundly-consulting/package-toolkit-for-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "^2.0"
    },
    "suggest": {
        "ext-curl": "Required to send guarded requests: DNS pinning uses CURLOPT_RESOLVE. Without it vet(), allows() and precheck() still judge URLs, but Http::safe(), guard(), http(), fetch(), download() and VettedDestination::pinningOptions() refuse with cannot_pin.",
        "ext-intl": "International (IDN) host names; without it they are refused."
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\SafeFetch\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\SafeFetch\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\SafeFetch\\SafeFetchServiceProvider"
            ],
            "aliases": {
                "SafeFetch": "RoundlyConsulting\\SafeFetch\\Facades\\SafeFetch"
            }
        }
    }
}
